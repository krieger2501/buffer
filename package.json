{
	"name": "serene-finance",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"dev": "vite dev",
		"format": "prettier --write . && sort-package-json",
		"knip": "knip",
		"lint": "eslint . && prettier --check . && sort-package-json --check",
		"lint:fix": "eslint . --fix && prettier --write . && sort-package-json",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"qc": "pnpm check && pnpm lint && pnpm knip && pnpm build && pnpm qc:git",
		"qc:git": "git rev-parse --git-dir > /dev/null 2>&1 && git diff --exit-code && git diff --cached --exit-code || echo 'Not a git repo, skipping clean-tree check'"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@supabase/supabase-js": "^2.105.1",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^1.0.1",
		"postgres": "^3.4.9",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@vite-pwa/sveltekit": "^1.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"knip": "^5.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sort-package-json": "^3.6.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	}
}
