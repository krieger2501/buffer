{
	"name": "buffer",
	"version": "2.1.3",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"code:lint": "eslint .",
		"code:lint:fix": "eslint . --fix",
		"commit:lint": "commitlint --from-last-tag --verbose",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"dev": "vite dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"package:check": "sort-package-json --check",
		"package:format": "sort-package-json",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"qc": "run-s package:check format:check commit:lint code:lint knip type:check build test:unit qc:git",
		"qc:git": "git rev-parse --git-dir > /dev/null 2>&1 && git diff --exit-code && git diff --cached --exit-code || echo 'Not a git repo, skipping clean-tree check'",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"type:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"type:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@supabase/ssr": "^0.10.2",
		"@supabase/supabase-js": "^2.105.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^1.0.1",
		"postgres": "^3.4.9",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.0",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^24.12.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.5",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"happy-dom": "^20.9.0",
		"knip": "^6.11.0",
		"npm-run-all2": "^8.0.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sort-package-json": "^3.6.1",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.10",
		"vitest": "^4.1.5",
		"wrangler": "^4.87.0"
	},
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0"
	}
}
